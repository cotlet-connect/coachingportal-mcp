{
  "mcpServers": {
    "cotlet": {
      "url": "https://cotlet.dev/mcp/v1",
      "headers": {
        "Authorization": "Bearer ${COTLET_API_KEY}"
      }
    },
    "coachingportal": {
      "command": "python3",
      "args": [
        "/absolute/path/to/coachingportal-mcp/coachingportal_agent.py",
        "serve"
      ],
      "env": {
        "COTLET_API_KEY": "${COTLET_API_KEY}"
      }
    }
  }
}
